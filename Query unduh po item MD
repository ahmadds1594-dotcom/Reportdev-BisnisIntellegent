SELECT
    -- HEADER
    P.GP_REFINTERNE                     AS Internal_reff,
    CONVERT(date, P.GP_DATEPIECE)      AS TANGGAL,
	P.GP_NUMERO as No_PO,

    --SITE / COMPANY
	--ET_ETABLISSEMENT					as site3,
    --P.GP_DEPOT                         AS Site1,
	P.GP_SOUCHE						   AS SITE2,
    E.ET_LIBELLE                       AS Nama_site,
    E.ET_ADRESSE1                      AS Alamat,
    E.ET_TELEPHONE                     AS Telephone,
    E.ET_CODEPOSTAL                    AS Kode_pos,
    E.ET_VILLE                         AS Kota,

    -- USER / APPROVAL
    U1.US_LIBELLE                      AS CREATED_BY,
    P.GP_VISEUR                        AS APPROVED_BY,
    U2.US_LIBELLE                      AS APPROVED_BY2,

    -- DOCUMENT INFO
    P.GP_LIBREPIECE1                   AS TYPE_PO,
    P.GP_LIBREPIECE2                   AS TYPE_PENERIMAAN,
    P.GP_DEVISE                        AS CURRENCY,
    P.GP_REGIMETAXE                    AS TAX,

    -- VENDOR
    V.T_TIERS                          AS vendor,
    V.T_LIBELLE                        AS Nama_vendor,
    V.T_ADRESSE1                       AS alamat_vendor,
    V.T_EMAIL                          AS EMAIL,
    V.T_CODEPOSTAL                     AS kodepos_vendor,
    V.T_VILLE                          AS kota_vendor,

    -- PAYMENT
    P.GP_MODEREGLE                     AS PAYMENT_TERM_CODE,
    M.MR_LIBELLE                       AS PAYMENT_TERM_DESC,

    -- DELIVERY
    CONVERT(date, P.GP_DATELIVRAISON)  AS DELIVERY_DATE,

    -- DETAIL
	L.GL_NUMERO						   AS NO_TRANSKASI,
    L.GL_NUMLIGNE                      AS NO_URUT,
    L.GL_NUMORDRE                      AS NO_URUT2,
    L.GL_CODEARTICLE                   AS Artikel_Code,
    L.GL_REFARTBARRE                   AS BARCODE,
    L.GL_LIBELLE                       AS DESCRIPTION,

	--ADDING
	ISNULL(DI1.GDI_LIBELLE, '')      AS WARNA,
	ISNULL(DI1.GDI_DIMORLI, '')      AS KODE_WARNA,
	ISNULL(DI2.GDI_LIBELLE, '')      AS SIZE,
	ISNULL(DI2.GDI_DIMORLI, '')      AS SIZE_KODE,
	ISNULL(SEASON.YX_LIBELLE, '')    AS SEASON,
	ISNULL(SEASONYEAR.YX_LIBELLE, '') AS SEASON_YEAR,
	ISNULL(BOARD.YX_LIBELLE, '')     AS BOAR,
    -- QTY / PRICE
    L.GL_QTEFACT                       AS QTY,
    A.GA_PVTTC                         AS TAG_PRICE,
    L.GL_PUHTDEV                       AS UNIT_PRICE,
    L.GL_REMISELIGNE                   AS DISKON,

    -- AMOUNT
    L.GL_TOTALHTDEV                    AS DPP,
    L.GL_TOTALTTCDEV - L.GL_TOTALHTDEV AS PPN,
    L.GL_TOTALTTCDEV                   AS TOTAL_AMOUNT,

    -- UDF / PLM
    ISNULL(r.MUD_VALCHAMP, '')   AS REMARKS_FI,
	ISNULL(m1.MUD_VALCHAMP, '')  AS [PLM - Approval by],
	ISNULL(b.MUD_VALCHAMP, '')   AS [PLM - Created by],
	ISNULL(c.MUD_VALCHAMP, '')   AS [PLM - PO No#],
	ISNULL(inc.MUD_VALCHAMP, '') AS INCOTERM

FROM PIECE P

LEFT JOIN LIGNE L
       ON P.GP_NUMERO = L.GL_NUMERO
      AND P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
      AND P.GP_SOUCHE = L.GL_SOUCHE

	  LEFT JOIN ARTICLE A
    ON A.GA_CODEARTICLE = L.GL_CODEARTICLE

LEFT JOIN ARTICLE_COMPL AC WITH(NOLOCK)
       ON L.GL_ARTICLE = AC.GA_ARTICLE

LEFT JOIN CHOIXCOD PRODUCTCATEGORY
    ON PRODUCTCATEGORY.CC_TYPE = 'FN4'
    AND PRODUCTCATEGORY.CC_CODE = AC.GA2_FAMILLENIV4

LEFT JOIN GCVTIERSCOMPL V
       ON P.GP_TIERS = V.T_TIERS

LEFT JOIN ETABLISS E
       ON P.GP_DEPOT = E.ET_ETABLISSEMENT

LEFT JOIN UTILISAT U1
       ON P.GP_CREATEUR = U1.US_UTILISATEUR

LEFT JOIN UTILISAT U2
       ON P.GP_VISEUR = U2.US_UTILISATEUR

LEFT JOIN MODEREGL M
       ON P.GP_MODEREGLE = M.MR_MODEREGLE

LEFT JOIN ARTICLE_COMPL WITH(NOLOCK)
       ON L.GL_ARTICLE = ARTICLE_COMPL.GA_ARTICLE

--LEFT JOIN ARTICLE A
--       ON A.GA_ARTICLE = L.GL_ARTICLE

LEFT JOIN CHOIXEXT Season
    ON Season.YX_TYPE = 'LA7' 
    AND Season.YX_CODE = A.GA_LIBREART7

LEFT JOIN CHOIXEXT SeasonYear
    ON SeasonYear.YX_TYPE = 'LA8' 
    AND SeasonYear.YX_CODE = A.GA_LIBREART8

LEFT JOIN CHOIXEXT Board
    ON Board.YX_TYPE = 'LA9' 
    AND Board.YX_CODE = A.GA_LIBREART9

-- DIMENSI
LEFT JOIN DIMENSION DI1
    ON LTRIM(RTRIM(DI1.GDI_TYPEDIM)) = 'DI1'
    AND DI1.GDI_CODEDIM = A.GA_CODEDIM1
    AND DI1.GDI_GRILLEDIM = A.GA_GRILLEDIM1

LEFT JOIN DIMENSION DI2
    ON LTRIM(RTRIM(DI2.GDI_TYPEDIM)) = 'DI2'
    AND DI2.GDI_CODEDIM = A.GA_CODEDIM2
    AND DI2.GDI_GRILLEDIM = A.GA_GRILLEDIM2



-- REMARKS FI
LEFT JOIN MCHPSUTILISATDATA r
       ON RTRIM(GP_NATUREPIECEG)+';'+GP_SOUCHE+';'+CAST(GP_NUMERO AS VARCHAR(18))+';'+CAST(GP_INDICEG AS VARCHAR(4)) = r.MUD_CLEENTITE
      AND r.MUD_IDCHAMP = 63

-- PLM APPROVAL
LEFT JOIN MCHPSUTILISATDATA m1
       ON RTRIM(GP_NATUREPIECEG)+';'+GP_SOUCHE+';'+CAST(GP_NUMERO AS VARCHAR(18))+';'+CAST(GP_INDICEG AS VARCHAR(4)) = m1.MUD_CLEENTITE
      AND m1.MUD_IDCHAMP = 157

-- PLM CREATED
LEFT JOIN MCHPSUTILISATDATA b
       ON RTRIM(GP_NATUREPIECEG)+';'+GP_SOUCHE+';'+CAST(GP_NUMERO AS VARCHAR(18))+';'+CAST(GP_INDICEG AS VARCHAR(4)) = b.MUD_CLEENTITE
      AND b.MUD_IDCHAMP = 158

-- PLM PO NUMBER
LEFT JOIN MCHPSUTILISATDATA c
       ON RTRIM(GP_NATUREPIECEG)+';'+GP_SOUCHE+';'+CAST(GP_NUMERO AS VARCHAR(18))+';'+CAST(GP_INDICEG AS VARCHAR(4)) = c.MUD_CLEENTITE
      AND c.MUD_IDCHAMP = 159

-- INCOTERM
LEFT JOIN MCHPSUTILISATDATA inc
       ON RTRIM(P.GP_TIERS) = RTRIM(inc.MUD_CLEENTITE)
      AND inc.MUD_IDCHAMP = 65
WHERE P.GP_DATEPIECE BETWEEN '2025-10-01' AND '2026-06-30'
 AND A.GA_TYPEARTICLE NOT IN ('FI')
  AND P.GP_NATUREPIECEG = 'CF'
  AND AC.GA2_FAMILLENIV4 NOT IN
(
    'BDX',
    'GWP',
    'HGR',
    'PPM',
    'SMP',
    'SRV',
    'TSR',
    'UNI'
)
AND V.T_TIERS NOT IN ('V102353')
ORDER BY
    P.GP_DATEPIECE,
    P.GP_NUMERO,
    L.GL_NUMLIGNE

