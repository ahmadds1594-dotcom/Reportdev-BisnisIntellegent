update yang sudah betul

SELECT
    CONVERT(date, L.GL_DATEPIECE)      AS Tanggal,
    L.GL_CODEARTICLE                   AS ARTIKEL,
	A.GA_PVTTC							AS RITEAIL_PRICE,
    A.GA_CODEBARRE                     AS barcode,
    L.GL_SOUCHE                        AS Site,
    B.CC_LIBELLE                       AS Brand,
    G.CC_LIBELLE                       AS Gender,
	 --  SIZE YANG BENAR
	SIZE.GDI_LIBELLE                   AS Ukuran,
	SUM(L.GL_TOTALHT)                  AS NetSales,
	--  WARNA 
    COLOR.GDI_LIBELLE                  AS Warna

FROM LIGNE L

LEFT JOIN ETABLISS E
    ON L.GL_SOUCHE = E.ET_ETABLISSEMENT

LEFT JOIN ARTICLE A
    ON L.GL_ARTICLE = A.GA_ARTICLE

LEFT JOIN ARTICLE_COMPL AC
    ON A.GA_ARTICLE = AC.GA_ARTICLE

-- Brand
LEFT JOIN CHOIXCOD B
    ON B.CC_TYPE = 'GDM'
    AND B.CC_CODE = AC.GA_DOMAINE

-- Gender
LEFT JOIN CHOIXCOD G
    ON G.CC_TYPE = 'FN1'
    AND G.CC_CODE = AC.GA_FAMILLENIV1

-- SIZE
LEFT JOIN DIMENSION SIZE 
    ON LTRIM(RTRIM(SIZE.GDI_TYPEDIM)) = 'DI2'
    AND SIZE.GDI_CODEDIM = AC.GA_CODEDIM2
    AND SIZE.GDI_GRILLEDIM = AC.GA_GRILLEDIM2

-- COLOR
LEFT JOIN DIMENSION COLOR 
    ON LTRIM(RTRIM(COLOR.GDI_TYPEDIM)) = 'DI1'
    AND COLOR.GDI_CODEDIM = AC.GA_CODEDIM1
    AND COLOR.GDI_GRILLEDIM = AC.GA_GRILLEDIM1

WHERE 
    L.GL_DATEPIECE >= '2026-02-18'
    AND L.GL_DATEPIECE < '2026-02-19'
    AND L.GL_NATUREPIECEG = 'FFO'
    AND B.CC_LIBELLE = 'EXECUTIVE'
    AND G.CC_LIBELLE = 'LADIES'
    AND L.GL_SOUCHE = '2015'

GROUP BY
    CONVERT(date, L.GL_DATEPIECE),
    L.GL_CODEARTICLE,
	A.GA_PVTTC,
    L.GL_SOUCHE,
    B.CC_LIBELLE,
    G.CC_LIBELLE,
    SIZE.GDI_LIBELLE,
    COLOR.GDI_LIBELLE,
    A.GA_CODEBARRE,
    A.GA_GRILLEDIM2,
    A.GA_GRILLEDIM1

ORDER BY
    Tanggal,
    ARTIKEL;




