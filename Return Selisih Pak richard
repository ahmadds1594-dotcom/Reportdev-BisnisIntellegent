-- ini yang oke
SELECT
    -- HEADER
    P.GP_NUMERO                             AS NO_TRANSAKSI,
    P.GP_REFINTERNE                         AS INTERNAL_REFF,
    CONVERT(date, P.GP_DATEPIECE)           AS TANGGAL,
    E.ET_ETABLISSEMENT                      AS SITE,
    E.ET_LIBELLE                            AS NAMA_SITE,
    E.ET_ADRESSE1                           AS ALAMAT,
    E.ET_TELEPHONE                          AS TELEPHONE,
    E.ET_CODEPOSTAL                         AS KODE_POS,
    E.ET_VILLE                              AS KOTA,
    U1.US_LIBELLE                           AS CREATED_BY,
    P.GP_LIBREPIECE1                        AS TYPE_PO,
    P.GP_LIBREPIECE2                        AS TYPE_PENERIMAAN,
    P.GP_DEVISE                             AS CURRENCY,
    P.GP_REGIMETAXE                         AS TAX,

    -- VENDOR
    V.T_TIERS                               AS VENDOR,
    V.T_LIBELLE                             AS NAMA_VENDOR,
    V.T_ADRESSE1                            AS ALAMAT_VENDOR,
    V.T_EMAIL                               AS EMAIL,
    V.T_CODEPOSTAL                          AS KODEPOS_VENDOR,
    V.T_VILLE                               AS KOTA_VENDOR,
    V.T_MODEREGLE                           AS PAYMENT_TERM_CODE,
    M.MR_LIBELLE                            AS PAYMENT_TERM_DESC,
    CONVERT(date, P.GP_DATELIVRAISON)       AS DELIVERY_DATE,

    -- DETAIL ARTIKEL
    L.GL_CODEARTICLE                        AS ARTIKEL_CODE,
    L.GL_REFARTBARRE                        AS BARCODE,
    L.GL_LIBELLE                            AS DESCRIPTION,
    ISNULL(GENDER.CC_LIBELLE, '')           AS GENDER,
    ISNULL(PRODUCTCATEGORY.CC_LIBELLE, '')  AS CATEGORY,
    ISNULL(PRODUCTSUBCATEGORY.CC_LIBELLE, '') AS SUB_CATEGORY,
    
   
    ISNULL(PRODUCT_TYPE.CC_LIBELLE, '')     AS TYPE,
    L.GL_QTEFACT                            AS QTY,
    A.GA_PVTTC                              AS TAG_PRICE,

    -- HARGA & SELISIH
    L.GL_PUHTDEV                            AS HARGA_BELI_TRANSAKSI,
    A.GA_DPA                                AS LAST_PURCHASE_MASTER,
    (L.GL_PUHTDEV - ISNULL(A.GA_DPA, 0))    AS SELISIH_HARGA,

    -- CALCULATED AMOUNT
    L.GL_REMISELIGNE                        AS DISKON,
    L.GL_TOTALHTDEV                         AS DPP,
    (L.GL_TOTALTTCDEV - L.GL_TOTALHTDEV)   AS PPN,
    L.GL_TOTALTTCDEV                        AS TOTAL_AMOUNT

FROM PIECE P
LEFT JOIN LIGNE L
    ON P.GP_NUMERO = L.GL_NUMERO
   AND P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
   AND P.GP_SOUCHE = L.GL_SOUCHE
LEFT JOIN GCVTIERSCOMPL V
    ON P.GP_TIERS = V.T_TIERS
LEFT JOIN ETABLISS E
    ON P.GP_ETABLISSEMENT = E.ET_ETABLISSEMENT
LEFT JOIN UTILISAT U1
    ON P.GP_CREATEUR = U1.US_UTILISATEUR
LEFT JOIN UTILISAT U2
    ON P.GP_VISEUR = U2.US_UTILISATEUR
LEFT JOIN MODEREGL M
    ON V.T_MODEREGLE = M.MR_MODEREGLE
LEFT JOIN ARTICLE A
    ON L.GL_ARTICLE = A.GA_ARTICLE
LEFT JOIN ARTICLE_COMPL WITH(NOLOCK)
    ON L.GL_ARTICLE = ARTICLE_COMPL.GA_ARTICLE

-- MASTER LOOKUP
LEFT JOIN CHOIXCOD BRAND
    ON BRAND.CC_TYPE = 'GDM'
   AND BRAND.CC_CODE = A.GA_DOMAINE
LEFT JOIN CHOIXCOD GENDER
    ON GENDER.CC_TYPE = 'FN1'
   AND GENDER.CC_CODE = A.GA_FAMILLENIV1
     --Product type
LEFT JOIN CHOIXCOD PRODUCT_TYPE
    ON PRODUCT_TYPE.CC_TYPE = 'FN3'
   AND PRODUCT_TYPE.CC_CODE = A.GA_FAMILLENIV3
     --kategory
LEFT JOIN CHOIXCOD PRODUCTCATEGORY
    ON PRODUCTCATEGORY.CC_TYPE = 'FN4'
   AND PRODUCTCATEGORY.CC_CODE = ARTICLE_COMPL.GA2_FAMILLENIV4
   --subkategory
LEFT JOIN CHOIXCOD PRODUCTSUBCATEGORY
    ON PRODUCTSUBCATEGORY.CC_TYPE = 'FN5'
   AND PRODUCTSUBCATEGORY.CC_CODE = ARTICLE_COMPL.GA2_FAMILLENIV5

WHERE 
        L.GL_DATEPIECE >= '2026-01-01'
        AND L.GL_DATEPIECE <= '2027-12-01'
  AND ARTICLE_COMPL.GA_TYPEARTICLE NOT IN ('FI')
  AND P.GP_NATUREPIECEG = 'BFA'
  AND P.GP_SOUCHE IN ('1100', '1101')

ORDER BY 
    P.GP_DATEPIECE,
    P.GP_NUMERO,
    L.GL_NUMLIGNE;
