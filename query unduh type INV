SELECT
    G.GL_DATEPIECE,
    G.GL_NUMERO,
    G.GL_SOUCHE,

    G.GL_CODEARTICLE,
    G.GL_LIBELLE,

    -- BOOK STOCK
    Z.ZGL_QTESIEGEINV as BookQty,

    -- FINAL STOCK
    Z.ZGL_INVENTAIRE as PhysicalInventory,

    -- DISC
    Z.ZGL_QTEFACT as Different,

    -- TAG PRICE
    Z.ZGL_PVTTC as TagPrice,

    -- TOTAL VALUE
    (Z.ZGL_PVTTC * Z.ZGL_QTEFACT) as TotalLine,

    A.GA_CODEBARRE as Barcode,

    G.LIBDIM1 AS WARNA,
    G.LIBDIM2 AS SIZE

FROM GCLIGNEARTDIM G

LEFT JOIN ZLISTEINVLIG Z
    ON G.GL_NUMERO = Z.ZGL_NUMERO
   AND G.GL_NUMLIGNE = Z.ZGL_NUMLIGNE

LEFT JOIN ARTICLE A
    ON A.GA_ARTICLE = G.GL_ARTICLE

WHERE
    G.GL_NATUREPIECEG = 'INV'
    AND G.GL_TYPELIGNE = 'ART'
    AND G.GL_DATEPIECE >= '2026-04-01'
    AND G.GL_DATEPIECE < '2026-04-05'

ORDER BY
    G.GL_NUMERO,
    G.GL_NUMLIGNE





	SELECT TOP 10 * FROM ZLISTEINVLIG
	SELECT TOP 10  * FROM GCLIGNEARTDIM
