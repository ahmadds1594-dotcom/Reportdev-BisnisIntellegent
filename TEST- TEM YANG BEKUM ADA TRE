  SELECT
    GCM.GP_ETABLISSEMENT  AS SENDER_SITE,
    GCM.GP_ETABLISSDEST   AS RECEIVE_SITE,
    GCM.GP_REFINTERNE     AS internalReference,
    GCM.GP_DATEPIECE      AS Gi_posting_date,
    SUM(ISNULL(GCM.GL_QTEFACT, 0)) AS Gi_qty

FROM dbo.GCLIGNEARTDIM GCM

WHERE
    RTRIM(GCM.GP_SUPPRIME) <> 'X'
    AND RTRIM(GCM.GP_NATUREPIECEG) = 'TEM'

    -- TEM 1399 → 1102
    AND GCM.GP_ETABLISSEMENT = '1399'
    AND GCM.GP_ETABLISSDEST = '1102'

    -- Periode
    AND GCM.GP_DATEPIECE >= '2026-04-01'
    AND GCM.GP_DATEPIECE <  '2026-04-16'

    -- Belum memiliki TRE berdasarkan Internal Reference
    AND NOT EXISTS (
        SELECT 1
        FROM PIECE P
        WHERE
            RTRIM(P.GP_NATUREPIECEG) = 'TRE'
            AND RTRIM(P.GP_SUPPRIME) <> 'X'
            AND P.GP_REFINTERNE = GCM.GP_REFINTERNE
    )

GROUP BY
    GCM.GP_ETABLISSEMENT,
    GCM.GP_ETABLISSDEST,
    GCM.GP_REFINTERNE,
    GCM.GP_DATEPIECE;
