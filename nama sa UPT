	SELECT 
    E.ET_ETABLISSEMENT AS [KODE SITE],
    E.ET_LIBELLE       AS [SITE],
    C.GCL_LIBELLE      AS [NAMA SA],
    CAST(P.GP_DATEPIECE AS DATE) AS [TANGGAL],
    
    -- Field Sales
    --SUM(L.GL_TOTALHT)     AS NetSales,
    --SUM(L.GL_TOTALTTC)    AS TotalTTC,
    SUM(L.GL_TOTALTTCDEV) AS CustomerPaid,
    
    -- Hitung Struk & Qty
    COUNT(DISTINCT P.GP_NUMERO) AS TotalStruk,
    SUM(L.GL_QTEFACT)           AS TotalQty,
    
    -- perhitungan di t-sql ATV & UPT
    CAST(SUM(L.GL_TOTALTTCDEV) / NULLIF(COUNT(DISTINCT P.GP_NUMERO), 0) AS DECIMAL(18,2)) AS ATV,
    CAST(SUM(L.GL_QTEFACT)     / NULLIF(COUNT(DISTINCT P.GP_NUMERO), 0) AS DECIMAL(18,2)) AS UPT

FROM PIECE P
INNER JOIN LIGNE L
    ON P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
   AND P.GP_SOUCHE       = L.GL_SOUCHE
   AND P.GP_NUMERO       = L.GL_NUMERO
   AND P.GP_INDICEG      = L.GL_INDICEG
   AND P.GP_DATEPIECE    = L.GL_DATEPIECE

INNER JOIN ETABLISS E 
    ON P.GP_ETABLISSEMENT = E.ET_ETABLISSEMENT

INNER JOIN COMMERCIAL C 
    ON L.GL_REPRESENTANT = C.GCL_COMMERCIAL

WHERE P.GP_NATUREPIECEG = 'FFO'
  AND P.GP_TYPECOMPTA = 'TIC'
  AND L.GL_DATEPIECE >= '2026-08-19'
  AND L.GL_DATEPIECE <  '2026-09-02'
  AND E.ET_ETABLISSEMENT IN ('2076', '2077', '2381', '2383', '2452')
  AND C.GCL_LIBELLE IN (
      'BELIAN INDAH MEMORY', 'DEVI PERMATASARI', 'KAYLA AYUNINGTIAS', 'EKA WIDYA PRATIWI',
      'NABILA ZAHIRA PUTRI', 'RISWA FACRIZA', 'LISA MAHARRANI', 'MAHARANI ANGELICA',
      'ISRA PRAMESTIAJI', 'M IRFANUDIN', 'DELIZA PUTRI ADILA', 'OCCI PITRYANI'
  )

GROUP BY 
    E.ET_ETABLISSEMENT,
    E.ET_LIBELLE,
    C.GCL_LIBELLE,
    CAST(P.GP_DATEPIECE AS DATE)

ORDER BY 
    E.ET_ETABLISSEMENT,
    C.GCL_LIBELLE,
    [TANGGAL];






















