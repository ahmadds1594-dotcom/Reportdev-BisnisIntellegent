SELECT
    CONVERT(date, G.GP_DATEPIECE) AS tanggal,
    G.GL_SOUCHE AS site,
    G.GP_NATUREPIECEG AS type_transaksi,
    G.GL_NUMERO AS Nomor_Transaksi,
    G.GP_REFINTERNE AS Internal_Reff,
    G.GL_CODEARTICLE AS artikel_code,
    G.GL_LIBELLE,
    G.GL_QTEFACT AS QTY_KU,
    A.GA_DOMAINE AS BRAND,
    A.GA_CODEBARRE AS Barcode,
    G.GL_PMRP AS COGS,
    G.LIBDIM1 AS WARNA,
    G.LIBDIM2 AS SIZE,
    PRODUCTCATEGORY.CC_LIBELLE AS Kategory

FROM GCLIGNEARTDIM G

INNER JOIN ARTICLECOMPL
    ON ARTICLECOMPL.GA2_ARTICLE = G.GL_ARTICLE

LEFT JOIN ARTICLE A
    ON A.GA_ARTICLE = G.GL_ARTICLE

LEFT JOIN CHOIXCOD PRODUCTCATEGORY
    ON PRODUCTCATEGORY.CC_TYPE = 'FN4'
   AND PRODUCTCATEGORY.CC_CODE = ARTICLECOMPL.GA2_FAMILLENIV4

WHERE
    G.GP_DATEPIECE >= '2025-01-01'
    AND G.GP_DATEPIECE < '2025-02-01'
    AND G.GP_NATUREPIECEG IN ('EEX','SEX','INV')
    AND G.GL_TYPELIGNE = 'ART'
    --AND G.GL_SOUCHE = '1100'
    --AND G.GL_NUMERO = '1850'
    AND ARTICLECOMPL.GA2_FAMILLENIV4 NOT IN ('BDX','GWP','HGR','PPM','SMP','SRV','TSR','UNI')
    AND (A.GA_FERME IS NULL OR A.GA_FERME <> 'X')

ORDER BY
    G.GL_NUMERO,
    G.GL_NUMLIGNE;
