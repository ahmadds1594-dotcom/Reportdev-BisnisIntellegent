SELECT
    C.MCC_CODECOND                    AS [Promo Code],
    C.MCC_LIBELLE                     AS [Promo Description],
    CONVERT(DATE,C.MCC_DATEDEBUTCOND) AS [Start Date],
    CONVERT(DATE,C.MCC_DATEFINCOND)   AS [End Date],
    T.MCN_QTEMIN                      AS [Minimum Qty],
    T.MCN_PRIX                        AS [Promo Price],
    C.MCC_TYPECONDCOM                 AS [Promotion Type]
FROM CONDITIONCOM C
LEFT JOIN MCONDCOMTRANCHE T
       ON C.MCC_CODECOND = T.MCN_CODECOND
WHERE C.MCC_CODECOND = 'ETC051';

select MCC_CODECOND,MCC_LIBELLE,MCC_DATEDEBUTCOND,MCC_DATEFINCOND,MCC_TYPECONDCOM,MCC_FERME from CONDITIONCOM where MCC_CODECOND='ETC051'
