SELECT 
    P.GP_ETABLISSEMENT AS SENDER_SITE,
    P.GP_ETABLISSDEST  AS RECEIVE_SITE,
    P.GP_NATUREPIECEG  AS NATURE_PIECE,
    P.GP_SOUCHE        AS SOUCHE,
    P.GP_NUMERO        AS NUMERO_HEADER,
    P.GP_REFINTERNE    AS INTERNAL_REFERENCE,
    P.GP_DATEPIECE     AS POSTING_DATE,
    P.GP_SUPPRIME      AS IS_DELETED
FROM 
    PIECE P
    LEFT JOIN LIGNE L
        ON  P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
        AND P.GP_DATEPIECE    = L.GL_DATEPIECE
        AND P.GP_SOUCHE        = L.GL_SOUCHE
        AND P.GP_NUMERO        = L.GL_NUMERO
        AND P.GP_INDICEG      = L.GL_INDICEG
WHERE 
    
    L.GL_NUMERO IS NULL
    AND RTRIM(P.GP_NATUREPIECEG) IN ('TRV', 'TEM', 'TRE')
    AND P.GP_ETABLISSDEST = '1399'
    AND P.GP_DATEPIECE >= '2025-01-01'
    AND P.GP_DATEPIECE <= '2027-01-01'
    --AND P.GP_REFINTERNE ='STRRET-SM-CLB-170726-2082-1399-DUS 05' --internall reff sample 
ORDER BY 
    P.GP_DATEPIECE DESC, 
    P.GP_NUMERO;
