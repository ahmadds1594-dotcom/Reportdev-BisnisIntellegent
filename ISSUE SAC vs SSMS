--1. Include Consignment (All Sales) Expected Customer Paid = 78.276.491

SELECT
    SUM(L.GL_TOTALHT)     AS NetSales,
    SUM(L.GL_TOTALTTC)    AS TotalTTC,
    SUM(L.GL_TOTALTTCDEV) AS CustomerPaid
FROM PIECE P
INNER JOIN LIGNE L
    ON P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
   AND P.GP_SOUCHE       = L.GL_SOUCHE
   AND P.GP_NUMERO       = L.GL_NUMERO
   AND P.GP_INDICEG      = L.GL_INDICEG
LEFT JOIN ARTICLE_COMPL AC
    ON L.GL_ARTICLE = AC.GA_ARTICLE
WHERE P.GP_NATUREPIECEG = 'FFO'
  AND P.GP_ETABLISSEMENT = '2312'
  AND P.GP_TYPECOMPTA = 'TIC'
  AND L.GL_DATEPIECE >= '2026-07-06'
  AND L.GL_DATEPIECE <  '2026-07-07';


  --2. Exclude Consignment (Non Consignment) Expected Customer Paid = 77.849.491


  SELECT
    SUM(L.GL_TOTALHT)     AS NetSales,
    SUM(L.GL_TOTALTTC)    AS TotalTTC,
    SUM(L.GL_TOTALTTCDEV) AS CustomerPaid
FROM PIECE P
INNER JOIN LIGNE L
    ON P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
   AND P.GP_SOUCHE       = L.GL_SOUCHE
   AND P.GP_NUMERO       = L.GL_NUMERO
   AND P.GP_INDICEG      = L.GL_INDICEG
LEFT JOIN ARTICLE_COMPL AC
    ON L.GL_ARTICLE = AC.GA_ARTICLE
LEFT JOIN CHOIXEXT Consignment
    ON Consignment.YX_TYPE = 'LA6'
   AND Consignment.YX_CODE = AC.GA_LIBREART6
WHERE P.GP_NATUREPIECEG = 'FFO'
  AND P.GP_ETABLISSEMENT = '2312'
  AND P.GP_TYPECOMPTA = 'TIC'
  AND L.GL_DATEPIECE >= '2026-07-06'
  AND L.GL_DATEPIECE <  '2026-07-07'
  AND ISNULL(LTRIM(RTRIM(AC.GA_LIBREART6)), '') = '';


