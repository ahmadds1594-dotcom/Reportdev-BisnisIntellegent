SELECT
    P.GP_SOUCHE,
    P.GP_ETABLIS,
    P.GP_DATEPIECE,
    P.GP_NATUREPIECEG,
    P.GP_NUMERO,
    L.GL_REFARBARRE,
    L.GL_QTEFACT,

    BRAND.CC_LIBELLE  AS Brand,
    GENDER.CC_LIBELLE AS Gender

FROM PIECE P

INNER JOIN LIGNE L
    ON P.GP_SOUCHE = L.GL_SOUCHE
   AND P.GP_NUMERO = L.GL_NUMERO
   AND P.GP_NATUREPIECEG = L.GL_NATUREPIECEG

LEFT JOIN ARTICLE A
    ON L.GL_CODEARTICLE = A.GA_CODEARTICLE

-- Brand
LEFT JOIN CHOIXCOD BRAND
    ON BRAND.CC_TYPE = 'GDM'
   AND BRAND.CC_CODE = A.GA_DOMAINE

-- Gender
LEFT JOIN CHOIXCOD GENDER
    ON GENDER.CC_TYPE = 'FN1'
   AND GENDER.CC_CODE = A.GA_FAMILLENIV1

WHERE
    P.GP_ETABLIS = 'C005'
    AND P.GP_DATEPIECE >= '2025-02-01'
    AND P.GP_DATEPIECE < '2025-03-01'
