SELECT 
    [Kode Site],
    [Nama Site],
    [Kota]
FROM (
    -- 1. SITE REGULER CEGID (Prefix 2, 8, 9 DARI ETABLISS)
    SELECT 
        E.ET_ETABLISSEMENT AS [Kode Site],
        E.ET_LIBELLE       AS [Nama Site],
        E.ET_VILLE         AS [Kota]
    FROM ETABLISS E
    WHERE LEFT(E.ET_ETABLISSEMENT, 1) IN ('2', '8', '9')

    UNION ALL

    -- 2. COST CENTER SITE (Prefix 5 & 6 DARI ZETABLISSCNTR)
    SELECT 
        Z.ZTC_ETABLISSMENT AS [Kode Site],
        COALESCE(E_CHILD.ET_LIBELLE, Z.ZTC_LIBELLE, Z.ZTC_ETABLISSMENT) AS [Nama Site],
        E_MAIN.ET_VILLE    AS [Kota]
    FROM ZETABLISSCNTR Z
    INNER JOIN ETABLISS E_MAIN 
        ON Z.ZTC_MAINETABLISSMENT = E_MAIN.ET_ETABLISSEMENT
    LEFT JOIN ETABLISS E_CHILD 
        ON Z.ZTC_ETABLISSMENT = E_CHILD.ET_ETABLISSEMENT
    WHERE LEFT(Z.ZTC_ETABLISSMENT, 1) IN ('5', '6')
      AND ISNULL(LTRIM(RTRIM(Z.ZTC_MAINETABLISSMENT)), '') <> ''
) AS MurniCegidSites

ORDER BY [Kode Site];
