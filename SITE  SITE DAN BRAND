

SELECT 
    ISNULL(Site.MAIN_SITE, '')                             AS MAIN_SITE,
    ISNULL(Site.KODE_SITE, '')                             AS KODE_SITE,
    ISNULL(BRAND.CC_LIBELLE, ISNULL(Site.KODE_BRAND, '')) AS BRAND,
    ISNULL(Site.TYPE_SITE, '')                             AS TYPE_SITE,
    ISNULL(Site.ADDRESS_1, '')                             AS ADDRESS_1,
    ISNULL(Site.ADDRESS_2, '')                             AS ADDRESS_2,
    ISNULL(Site.CITY, '')                                  AS CITY,
    ISNULL(Site.POST_CODE, '')                             AS POST_CODE,
    ISNULL(Site.EMAIL, '')                                 AS EMAIL
FROM (
    -- 1. BAGIAN ETABLISS (KHUSUS Kepala 2, 8, dan 9)
    SELECT 
        UPPER(ISNULL(Z_MAP.ZTC_MAINETABLISSMENT, E.ET_ETABLISSEMENT)) AS MAIN_SITE,
        E.ET_ETABLISSEMENT  AS KODE_SITE,
        E.ET_ADRESSE1       AS ADDRESS_1,
        E.ET_ADRESSE2       AS ADDRESS_2,
        E.ET_VILLE          AS CITY,
        E.ET_CODEPOSTAL     AS POST_CODE,
        E.ET_EMAIL          AS EMAIL,

        CASE 
            WHEN LEFT(E.ET_ETABLISSEMENT, 1) = '2' THEN 'Store'
            WHEN LEFT(E.ET_ETABLISSEMENT, 1) IN ('8', '9') THEN 'Bazar'
            ELSE 'Store'
        END AS TYPE_SITE,

        -- BRAND POLOS APA ADANYA DARI ET_LIBREET3
        E.ET_LIBREET3 AS KODE_BRAND

    FROM ETABLISS E
    LEFT JOIN (
        SELECT DISTINCT ZTC_ETABLISSMENT, ZTC_MAINETABLISSMENT
        FROM ZETABLISSCNTR
        WHERE ISNULL(LTRIM(RTRIM(ZTC_MAINETABLISSMENT)), '') NOT IN ('', '0', ';')
    ) Z_MAP ON E.ET_ETABLISSEMENT = Z_MAP.ZTC_ETABLISSMENT
    WHERE LEFT(E.ET_ETABLISSEMENT, 1) IN ('2', '8', '9')

    UNION ALL

    -- 2. BAGIAN ZETABLISSCNTR (KHUSUS Kepala 5 & 6)
    SELECT 
        UPPER(Z.ZTC_MAINETABLISSMENT) AS MAIN_SITE,
        Z.ZTC_ETABLISSMENT     AS KODE_SITE,
        COALESCE(E_CHILD.ET_ADRESSE1, E_MAIN.ET_ADRESSE1)   AS ADDRESS_1,
        COALESCE(E_CHILD.ET_ADRESSE2, E_MAIN.ET_ADRESSE2)   AS ADDRESS_2,
        COALESCE(E_CHILD.ET_VILLE, E_MAIN.ET_VILLE)         AS CITY,
        COALESCE(E_CHILD.ET_CODEPOSTAL, E_MAIN.ET_CODEPOSTAL) AS POST_CODE,
        COALESCE(E_CHILD.ET_EMAIL, E_MAIN.ET_EMAIL)         AS EMAIL,

        CASE 
            WHEN LEFT(Z.ZTC_ETABLISSMENT, 1) IN ('5', '6') THEN 'Counter'
            ELSE 'Counter'
        END AS TYPE_SITE,

        -- BRAND POLOS APA ADANYA (ZETABLISSCNTR -> CHILD -> MAIN)
        COALESCE(Z.ZTC_LIBREZTC3, E_CHILD.ET_LIBREET3, E_MAIN.ET_LIBREET3) AS KODE_BRAND

    FROM ZETABLISSCNTR Z
    INNER JOIN ETABLISS E_MAIN 
        ON Z.ZTC_MAINETABLISSMENT = E_MAIN.ET_ETABLISSEMENT
    LEFT JOIN ETABLISS E_CHILD 
        ON Z.ZTC_ETABLISSMENT = E_CHILD.ET_ETABLISSEMENT
    WHERE LEFT(Z.ZTC_ETABLISSMENT, 1) IN ('5', '6')
      AND UPPER(ISNULL(LTRIM(RTRIM(Z.ZTC_MAINETABLISSMENT)), '')) NOT IN ('', '0', ';')
      -- Filter Toko Masih Aktif / Belum Closing
      AND (
          Z.ZTC_CLOSINGDATE IS NULL 
          OR CAST(Z.ZTC_CLOSINGDATE AS DATE) = '1900-01-01'
          OR CAST(Z.ZTC_CLOSINGDATE AS VARCHAR) IN ('0', '', '19000101')
      )
) AS Site

-- JOIN ke CHOIXCOD untuk tarik Nama Brand
LEFT JOIN CHOIXCOD BRAND
    ON BRAND.CC_TYPE = 'GDM'
   AND BRAND.CC_CODE = Site.KODE_BRAND

ORDER BY Site.KODE_SITE;








--BRAND APA ADANYA
SELECT 
    ISNULL(Site.MAIN_SITE, '')  AS MAIN_SITE,
    ISNULL(Site.KODE_SITE, '')  AS KODE_SITE,
    ISNULL(Site.KODE_BRAND, '') AS BRAND,
    ISNULL(Site.TYPE_SITE, '')  AS TYPE_SITE,
    ISNULL(Site.ADDRESS_1, '')  AS ADDRESS_1,
    ISNULL(Site.ADDRESS_2, '')  AS ADDRESS_2,
    ISNULL(Site.CITY, '')       AS CITY,
    ISNULL(Site.POST_CODE, '')  AS POST_CODE,
    ISNULL(Site.EMAIL, '')      AS EMAIL
FROM (
    -- 1. BAGIAN ETABLISS (KHUSUS Kepala 2, 8, dan 9)
    SELECT 
        UPPER(ISNULL(Z_MAP.ZTC_MAINETABLISSMENT, E.ET_ETABLISSEMENT)) AS MAIN_SITE,
        E.ET_ETABLISSEMENT  AS KODE_SITE,
        E.ET_ADRESSE1       AS ADDRESS_1,
        E.ET_ADRESSE2       AS ADDRESS_2,
        E.ET_VILLE          AS CITY,
        E.ET_CODEPOSTAL     AS POST_CODE,
        E.ET_EMAIL          AS EMAIL,

        CASE 
            WHEN LEFT(E.ET_ETABLISSEMENT, 1) = '2' THEN 'Store'
            WHEN LEFT(E.ET_ETABLISSEMENT, 1) IN ('8', '9') THEN 'Bazar'
            ELSE 'Store'
        END AS TYPE_SITE,

        -- BRAND POLOS APA ADANYA
        E.ET_LIBREET3 AS KODE_BRAND

    FROM ETABLISS E
    LEFT JOIN (
        SELECT DISTINCT ZTC_ETABLISSMENT, ZTC_MAINETABLISSMENT
        FROM ZETABLISSCNTR
        WHERE ISNULL(LTRIM(RTRIM(ZTC_MAINETABLISSMENT)), '') NOT IN ('', '0', ';')
    ) Z_MAP ON E.ET_ETABLISSEMENT = Z_MAP.ZTC_ETABLISSMENT
    WHERE LEFT(E.ET_ETABLISSEMENT, 1) IN ('2', '8', '9')

    UNION ALL

    -- 2. BAGIAN ZETABLISSCNTR (KHUSUS Kepala 5 & 6)
    SELECT 
        UPPER(Z.ZTC_MAINETABLISSMENT) AS MAIN_SITE,
        Z.ZTC_ETABLISSMENT     AS KODE_SITE,
        COALESCE(E_CHILD.ET_ADRESSE1, E_MAIN.ET_ADRESSE1)   AS ADDRESS_1,
        COALESCE(E_CHILD.ET_ADRESSE2, E_MAIN.ET_ADRESSE2)   AS ADDRESS_2,
        COALESCE(E_CHILD.ET_VILLE, E_MAIN.ET_VILLE)         AS CITY,
        COALESCE(E_CHILD.ET_CODEPOSTAL, E_MAIN.ET_CODEPOSTAL) AS POST_CODE,
        COALESCE(E_CHILD.ET_EMAIL, E_MAIN.ET_EMAIL)         AS EMAIL,

        CASE 
            WHEN LEFT(Z.ZTC_ETABLISSMENT, 1) IN ('5', '6') THEN 'Counter'
            ELSE 'Counter'
        END AS TYPE_SITE,

        -- BRAND POLOS APA ADANYA
        COALESCE(Z.ZTC_LIBREZTC3, E_CHILD.ET_LIBREET3, E_MAIN.ET_LIBREET3) AS KODE_BRAND

    FROM ZETABLISSCNTR Z
    INNER JOIN ETABLISS E_MAIN 
        ON Z.ZTC_MAINETABLISSMENT = E_MAIN.ET_ETABLISSEMENT
    LEFT JOIN ETABLISS E_CHILD 
        ON Z.ZTC_ETABLISSMENT = E_CHILD.ET_ETABLISSEMENT
    WHERE LEFT(Z.ZTC_ETABLISSMENT, 1) IN ('5', '6')
      AND UPPER(ISNULL(LTRIM(RTRIM(Z.ZTC_MAINETABLISSMENT)), '')) NOT IN ('', '0', ';')
      
      -- FILTER HANYA TOKO AKTIF (ABAIKAN KETIKA SUDAH CLOSING)
      AND ZTC_CLOSINGDATE = '1900-01-01 00:00:00.000'
) AS Site

ORDER BY Site.KODE_SITE;












