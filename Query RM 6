;WITH OM AS (
    SELECT
        ZCE_ETABLISSEMENT,
        ZCE_COMMERCIAL,
        ZCE_EMAIL,
        ZCE_PERIODE,
        ROW_NUMBER() OVER (
            PARTITION BY ZCE_ETABLISSEMENT
            ORDER BY ZCE_PERIODE DESC
        ) AS rn
    FROM ZETABPOS
    WHERE ZCE_POSITION = 'OM' -- 
)
SELECT
    OM.ZCE_ETABLISSEMENT AS Site,

    CRS.GCL_LIBELLE AS RS_NAME,
    RS.ZCE_EMAIL    AS RS_EMAIL,

    CRM.GCL_LIBELLE AS RM_NAME,
    RM.ZCE_EMAIL    AS RM_EMAIL,

    COM.GCL_LIBELLE AS OM_NAME,
    OM.ZCE_EMAIL    AS OM_EMAIL
FROM OM

-- Ambil Rs Terakhir
OUTER APPLY (
    SELECT TOP (1)
        ZCE_COMMERCIAL,
        ZCE_EMAIL
    FROM ZETABPOS
    WHERE ZCE_ETABLISSEMENT = OM.ZCE_ETABLISSEMENT
      AND ZCE_POSITION = 'RS'
    ORDER BY ZCE_PERIODE DESC
) RS

-- Ambil RS 
OUTER APPLY (
    SELECT TOP (1)
        ZCE_COMMERCIAL,
        ZCE_EMAIL
    FROM ZETABPOS
    WHERE ZCE_ETABLISSEMENT = OM.ZCE_ETABLISSEMENT
      AND ZCE_POSITION = 'RM'
    ORDER BY ZCE_PERIODE DESC
) RM

-- Join yang aman mencakup GCL_COMMERCIAL & GCL_ETABLISSEMENT
LEFT JOIN COMMERCIAL CRS 
       ON CRS.GCL_COMMERCIAL = RS.ZCE_COMMERCIAL 
       OR CRS.GCL_ETABLISSEMENT = RS.ZCE_COMMERCIAL

LEFT JOIN COMMERCIAL CRM 
       ON CRM.GCL_COMMERCIAL = RM.ZCE_COMMERCIAL 
       OR CRM.GCL_ETABLISSEMENT = RM.ZCE_COMMERCIAL

LEFT JOIN COMMERCIAL COM 
       ON COM.GCL_COMMERCIAL = OM.ZCE_COMMERCIAL 
       OR COM.GCL_ETABLISSEMENT = OM.ZCE_COMMERCIAL

WHERE OM.rn = 1
  AND COM.GCL_LIBELLE = 'Novi Thomas'
ORDER BY OM.ZCE_ETABLISSEMENT;
