-- TEST TOTAL COUNT ART DESC COLOR & SIZE > 1
-- + BRAND
-- + CATEGORY
-- + CURRENT STOCK

SELECT
	
    ARTICLE.GA_CODEBARRE AS Barcode,
    ARTICLE.GA_CODEARTICLE AS ItemCode,
    ARTICLE.GA_LIBELLE AS Article_Desc,
	--QUERY TAMBAHAN
	ISNULL(CONVERT(date, ARTICLE.GA_DATECREATION), '') AS Created_Date,
	ISNULL(U1.US_LIBELLE,'') AS Created_By,

	ISNULL(CONVERT(date, ARTICLE.GA_DATEMODIF), '') AS Last_Modified_Date,
	ISNULL(U2.US_LIBELLE,'') AS Last_Modified_By,

    DI1.GDI_LIBELLE AS Color,
    DI1.GDI_DIMORLI AS Color_Code,
    DI2.GDI_LIBELLE AS Size,

    BRAND.CC_LIBELLE AS Brand,
    CATEGORY.CC_LIBELLE AS Category,

    ISNULL(STOCK.Current_Stock,0) AS Current_Stock,

    CASE
        WHEN ISNULL(ARTICLE.GA_FERME,'')='X'
            THEN 'Close'
        ELSE 'Open'
    END AS Status_Artikel

FROM ARTICLE

INNER JOIN ARTICLECOMPL
    ON ARTICLECOMPL.GA2_ARTICLE = ARTICLE.GA_ARTICLE

--join tambahan 
LEFT JOIN UTILISAT U1
    ON ARTICLE.GA_CREATEUR = U1.US_UTILISATEUR

LEFT JOIN UTILISAT U2
    ON ARTICLE.GA_UTILISATEUR = U2.US_UTILISATEUR

-- BRAND
LEFT JOIN CHOIXCOD BRAND
    ON BRAND.CC_TYPE = 'GDM'
   AND BRAND.CC_CODE = ARTICLE.GA_DOMAINE
   
-- CATEGORY
LEFT JOIN CHOIXCOD CATEGORY
    ON CATEGORY.CC_TYPE = 'FN4'
   AND CATEGORY.CC_CODE = ARTICLECOMPL.GA2_FAMILLENIV4

-- COLOR
LEFT JOIN DIMENSION DI1
    ON LTRIM(RTRIM(DI1.GDI_TYPEDIM))='DI1'
   AND DI1.GDI_CODEDIM = ARTICLE.GA_CODEDIM1
   AND DI1.GDI_GRILLEDIM = ARTICLE.GA_GRILLEDIM1

-- SIZE
LEFT JOIN DIMENSION DI2
    ON LTRIM(RTRIM(DI2.GDI_TYPEDIM))='DI2'
   AND DI2.GDI_CODEDIM = ARTICLE.GA_CODEDIM2
   AND DI2.GDI_GRILLEDIM = ARTICLE.GA_GRILLEDIM2

-- CURRENT STOCK
LEFT JOIN
(
    SELECT
        GQ_ARTICLE,
        SUM(GQ_PHYSIQUE) AS Current_Stock
    FROM DISPO
    GROUP BY GQ_ARTICLE
) STOCK
    ON STOCK.GQ_ARTICLE = ARTICLE.GA_ARTICLE

-- DUPLICATE ARTICLE + COLOR + SIZE
INNER JOIN
(
    SELECT
        A.GA_LIBELLE AS Article_Desc,
        D1.GDI_LIBELLE AS Color,
        D2.GDI_LIBELLE AS Size

    FROM ARTICLE A

    INNER JOIN ARTICLECOMPL AC
        ON AC.GA2_ARTICLE = A.GA_ARTICLE

    LEFT JOIN DIMENSION D1
        ON LTRIM(RTRIM(D1.GDI_TYPEDIM))='DI1'
       AND D1.GDI_CODEDIM = A.GA_CODEDIM1
       AND D1.GDI_GRILLEDIM = A.GA_GRILLEDIM1

    LEFT JOIN DIMENSION D2
        ON LTRIM(RTRIM(D2.GDI_TYPEDIM))='DI2'
       AND D2.GDI_CODEDIM = A.GA_CODEDIM2
       AND D2.GDI_GRILLEDIM = A.GA_GRILLEDIM2

    WHERE
        A.GA_STATUTART <> 'GEN'
        AND AC.GA2_FAMILLENIV4 NOT IN
        ('BDX','GWP','HGR','PPM','SMP','SRV','TSR','UNI')
		
    GROUP BY
        A.GA_LIBELLE,
        D1.GDI_LIBELLE,
        D2.GDI_LIBELLE

    HAVING COUNT(*) > 1

) DUP
    ON DUP.Article_Desc = ARTICLE.GA_LIBELLE
   AND DUP.Color = DI1.GDI_LIBELLE
   AND DUP.Size = DI2.GDI_LIBELLE

WHERE
    ARTICLE.GA_STATUTART <> 'GEN'
    AND ARTICLECOMPL.GA2_FAMILLENIV4 NOT IN
    ('BDX','GWP','HGR','PPM','SMP','SRV','TSR','UNI')
	

ORDER BY
    ARTICLE.GA_LIBELLE,
    DI1.GDI_LIBELLE,
    DI2.GDI_LIBELLE;

