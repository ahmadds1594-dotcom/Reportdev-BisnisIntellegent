SELECT 
    --E.ET_ETABLISSEMENT              AS MAIN_SITE,
    E.ET_ETABLISSEMENT              AS KODE_SITE,
    E.ET_LIBELLE                    AS NAMA_SITE,
    ISNULL(E.ET_LIBREET3, '')       AS BRAND,
    ISNULL(CHN.YX_LIBELLE, ISNULL(E.ET_LIBREET9, '')) AS TYPE_SITE,
    ISNULL(M4.MUD_VALCHAMP, '')     AS Store_Space,
    ISNULL(M5.MUD_VALCHAMP, '')     AS Area_Unit,
    ISNULL(E.ET_ADRESSE1, '')       AS ADDRESS_1,
    ISNULL(E.ET_ADRESSE2, '')       AS ADDRESS_2,
    ISNULL(E.ET_VILLE, '')          AS CITY,
    ISNULL(E.ET_CODEPOSTAL, '')     AS POST_CODE,
    ISNULL(COALESCE(NULLIF(E.ET_EMAIL, ''), NULLIF(E.ET_EMAIL2, '')), '') AS EMAIL,
    CASE 
        WHEN E.ET_FERME = 'X' THEN 'Close'
        ELSE 'Open'
    END AS STATUS
FROM ETABLISS E

-- JOIN 1: Untuk Store Space (IDCHAMP 4)
LEFT JOIN MCHPSUTILISATDATA M4
    ON E.ET_ETABLISSEMENT = RTRIM(M4.MUD_CLEENTITE)
   AND M4.MUD_ENTITEMCD = 'ETA'
   AND M4.MUD_IDCHAMP = 4

-- JOIN 2: Untuk Area Unit (IDCHAMP 5)
LEFT JOIN MCHPSUTILISATDATA M5
    ON E.ET_ETABLISSEMENT = RTRIM(M5.MUD_CLEENTITE)
   AND M5.MUD_ENTITEMCD = 'ETA'
   AND M5.MUD_IDCHAMP = 5

-- JOIN ke CHOIXEXT untuk deskripsi TYPE_SITE
LEFT JOIN CHOIXEXT CHN
    ON CHN.YX_TYPE = 'EL9'
   AND CHN.YX_CODE = E.ET_LIBREET9

-- KHUSUS KEPALA 2 SAJA
WHERE LEFT(E.ET_ETABLISSEMENT, 1) = '2'

ORDER BY E.ET_ETABLISSEMENT;

