SELECT
    S.SalesDate AS Tanggal,
    S.Site,
    E.ET_LIBELLE AS Nama_Site,
    ISNULL(T.Target,0) AS Target,
    S.Customer_Paid,
    E.ET_DATELIBRE1 AS Opening_Toko
FROM
(
    SELECT
        CONVERT(DATE,P.GP_DATEPIECE) AS SalesDate,

        CASE
            WHEN LEFT(P.GP_ETABLISSEMENT,1)='C'
                THEN ZTC.ZTC_ETABLISSMENT
            ELSE
                P.GP_SOUCHE
        END AS Site,

        SUM(L.GL_TOTALTTCDEV) AS Customer_Paid

    FROM PIECE P

    INNER JOIN LIGNE L
        ON P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
       AND P.GP_SOUCHE       = L.GL_SOUCHE
       AND P.GP_NUMERO       = L.GL_NUMERO
       AND P.GP_INDICEG      = L.GL_INDICEG

    LEFT JOIN ARTICLE A
        ON A.GA_ARTICLE = L.GL_ARTICLE

    LEFT JOIN ZETABLISSCNTR ZTC
        ON P.GP_ETABLISSEMENT = ZTC.ZTC_MAINETABLISSMENT
       AND A.GA_DOMAINE       = ZTC.ZTC_LIBREZTC3
       AND A.GA_FAMILLENIV1   = ZTC.ZTC_LIBREZTC2

    WHERE
        
    P.GP_NATUREPIECEG = 'FFO'
    AND ISNULL(P.GP_TICKETANNULE,'') <> 'X'
    --AND ISNULL(A.GA_DOMAINE,'') <> ''
    --AND ISNULL(A.GA_FAMILLENIV1,'') <> ''
    AND P.GP_DATEPIECE >= DATEFROMPARTS(YEAR(GETDATE()),MONTH(GETDATE()),1)
    AND P.GP_DATEPIECE < DATEADD(MONTH,1,DATEFROMPARTS(YEAR(GETDATE()),MONTH(GETDATE()),1))

    GROUP BY
        CONVERT(DATE,P.GP_DATEPIECE),

        CASE
            WHEN LEFT(P.GP_ETABLISSEMENT,1)='C'
                THEN ZTC.ZTC_ETABLISSMENT
            ELSE
                P.GP_SOUCHE
        END

) S

LEFT JOIN
(
    SELECT
        ZEY_PERIODE,
        ZEY_ETABLISSEMENT,
        SUM(ZEY_TARGET) AS Target
    FROM ZETABTARGETBRANDDAILY
    GROUP BY
        ZEY_PERIODE,
        ZEY_ETABLISSEMENT
) T
    ON T.ZEY_ETABLISSEMENT = S.Site
   AND T.ZEY_PERIODE = (YEAR(S.SalesDate) * 100) + MONTH(S.SalesDate)

INNER JOIN ETABLISS E
    ON E.ET_ETABLISSEMENT = S.Site

WHERE
    LEFT(S.Site,1) IN ('2','5','6','8','9')
    AND ISNULL(T.Target,0)=0

ORDER BY
    S.SalesDate,
    S.Site;
