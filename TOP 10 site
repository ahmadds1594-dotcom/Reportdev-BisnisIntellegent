Kalau mau Include Consignment (All Sales), cukup tambahkan join ke ARTICLE_COMPL (kalau nanti mau dipakai filter) tapi jangan tambahkan filter GA_LIBREART6.

Querynya jadi:
--top 10 toko dengan semua kondisi consighment dan non consighment


  SELECT TOP (10)

    ROW_NUMBER() OVER (ORDER BY SUM(L.GL_TOTALTTCDEV) DESC) AS Ranking,

    P.GP_ETABLISSEMENT                    AS Site,
    E.ET_LIBELLE                          AS NamaToko,

    COUNT(DISTINCT P.GP_NUMERO)           AS TotalTransaksi,

    SUM(L.GL_QTEFACT)                     AS TotalQty,
    SUM(L.GL_TOTALHT)                     AS NetSales,
    SUM(L.GL_TOTALTTCDEV)                 AS CustomerPaid

FROM PIECE P

INNER JOIN LIGNE L
    ON P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
   AND P.GP_SOUCHE       = L.GL_SOUCHE
   AND P.GP_NUMERO       = L.GL_NUMERO
   AND P.GP_INDICEG      = L.GL_INDICEG

LEFT JOIN ARTICLE_COMPL AC
    ON L.GL_ARTICLE = AC.GA_ARTICLE

LEFT JOIN ETABLISS E
    ON P.GP_ETABLISSEMENT = E.ET_ETABLISSEMENT

WHERE P.GP_NATUREPIECEG IN ('FFO')
  AND LEFT(P.GP_SOUCHE,1) IN ('2','8')
  AND P.GP_SUPPRIME <> 'X'
  AND P.GP_CONFIE <> 'X'
  AND P.GP_TYPECOMPTA = 'TIC'
  AND P.GP_DATEPIECE >= '2026-06-01'
  AND P.GP_DATEPIECE <  '2026-06-02'

GROUP BY
    P.GP_ETABLISSEMENT,
    E.ET_LIBELLE

ORDER BY
    CustomerPaid DESC;


