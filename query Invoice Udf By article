WITH CTE AS (
    SELECT
        CONVERT(date, P.GP_DATEPIECE) AS Tanggal,
        P.GP_NATUREPIECEG AS Reference,
        P.GP_SOUCHE AS Site,
        P.GP_NUMERO AS No_Invoice,
		A.GA_CODEARTICLE	AS Artikel,
        A.GA_CODEBARRE AS Barcode,
		A.GA_LIBELLE	AS Artikel_deskripsi,
		
        inv.MUD_VALCHAMP AS SUPPLIER_INVOICE_NO,

        ROW_NUMBER() OVER (
            PARTITION BY A.GA_CODEBARRE
            ORDER BY P.GP_DATEPIECE DESC,
                     P.GP_NUMERO DESC
        ) AS RN

    FROM PIECE P

    INNER JOIN LIGNE L
        ON P.GP_SOUCHE = L.GL_SOUCHE
       AND P.GP_NUMERO = L.GL_NUMERO
	   AND P.GP_NATUREPIECEG = L.GL_NATUREPIECEG

    INNER JOIN ARTICLE A
        ON L.GL_ARTICLE = A.GA_ARTICLE

    LEFT JOIN MCHPSUTILISATDATA inv
           ON RTRIM(P.GP_NATUREPIECEG)+';'+P.GP_SOUCHE+';'
            + CAST(P.GP_NUMERO AS VARCHAR(18))+';'
            + CAST(P.GP_INDICEG AS VARCHAR(4)) = inv.MUD_CLEENTITE
          AND inv.MUD_IDCHAMP = 4

    WHERE P.GP_NATUREPIECEG IN ('FF','FFF')
      AND P.GP_DATEPIECE >= '2022-01-01'
      AND P.GP_DATEPIECE < '2026-07-01'
      AND A.GA_CODEBARRE IN (
	  
	 
	'910005872002', '910006909003', '910005408003', '9990000039418', '910007107003', '910005671014', '910005671012', ' 1210315KCH28 ', '910004712001', 
'9990000828999', '9990000829002', '9990000828982', '9990000828975', '9990000029051', '9990000117390', '9990000136926', '9990000207824', '950012407006', 
'950011537005', '950011590007', '9990000136971', '950009894013', '9990000136933', '9990000117406', '9990000029044', '950011539004', '950008901001', '950012036001', 
'9990000014972', '9990000080243', '9990000015047', '9990000080199', '9990000015030', '9990000015054', '9990000186440', '950012665003', '950012665004', '910006745012', 
'910006745014', '910005668014', '910005668004', '910006744017', '910006744013', '910006744012', '910006744010', '910006744015', '910006744014', '910006744016', '910006745016', 
'910006744018', '910006745011', '9990000167463', '910006441001', '910007049002', '910005241004', '910006769002', '9990000073504', '9990000028825', '9990000101443', '950014188008', 
'9990000046294', '9990000101436', '910006744023', '910006745010', '910006745015', '910006745018', '910006744022', '910006744021', '910006744025'
      )
)

SELECT
    Tanggal,
    Reference,
    Site,
    No_Invoice,
	Artikel,
	Barcode,
	Artikel_deskripsi,
	
    SUPPLIER_INVOICE_NO
FROM CTE
WHERE RN = 1
ORDER BY BARCODE
