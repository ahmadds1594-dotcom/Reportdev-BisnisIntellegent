SELECT
    P.GP_NATUREPIECEG,
    P.GP_REFINTERNE,
    P.GP_SOUCHE,
    P.GP_NUMERO,
    CONVERT(DATE, P.GP_DATEPIECE) AS GP_DATEPIECE,
    CONVERT(DATE, P.GP_DATELIVRAISON) AS GP_DATELIVRAISON,
    P.GP_TIERS,
    V.T_LIBELLE,

    L.GL_CODEARTICLE,
    L.GL_REFARTBARRE,

    A.GA_LIBELLE AS ARTICLE_DESCRIPTION,
	SIZE.GDI_LIBELLE AS SIZE_DESC,
	COLOR.GDI_LIBELLE AS COLOR_DESC,

	
    BRAND.CC_LIBELLE AS BRAND,

    CAST(SUM(L.GL_QTEFACT) AS NUMERIC(18,0)) AS total

FROM PIECE P
JOIN LIGNE L
    ON P.GP_NATUREPIECEG = L.GL_NATUREPIECEG
   AND P.GP_SOUCHE       = L.GL_SOUCHE
   AND P.GP_NUMERO       = L.GL_NUMERO
   AND P.GP_INDICEG      = L.GL_INDICEG

LEFT JOIN ARTICLE A
    ON A.GA_CODEARTICLE = L.GL_CODEARTICLE
   AND L.GL_ARTICLE = A.GA_ARTICLE

LEFT JOIN ARTICLE_COMPL WITH(NOLOCK)
    ON L.GL_ARTICLE = ARTICLE_COMPL.GA_ARTICLE

LEFT JOIN CHOIXCOD BRAND
    ON BRAND.CC_TYPE = 'GDM'
   AND BRAND.CC_CODE = A.GA_DOMAINE

LEFT JOIN GCVTIERSCOMPL V 
	ON P.GP_TIERS = V.T_TIERS

LEFT JOIN dbo.DIMENSION SIZE 
    ON LTRIM(RTRIM(SIZE.GDI_TYPEDIM)) = 'DI2' 
   AND SIZE.GDI_CODEDIM = ARTICLE_COMPL.GA_CODEDIM2
   AND SIZE.GDI_GRILLEDIM = ARTICLE_COMPL.GA_GRILLEDIM2

LEFT JOIN dbo.DIMENSION COLOR 
    ON LTRIM(RTRIM(COLOR.GDI_TYPEDIM)) = 'DI1' 
   AND COLOR.GDI_CODEDIM = ARTICLE_COMPL.GA_CODEDIM1 
   AND COLOR.GDI_GRILLEDIM = ARTICLE_COMPL.GA_GRILLEDIM1
WHERE
    P.GP_NATUREPIECEG IN ('CF','BLF')
    AND ARTICLE_COMPL.GA_TYPEARTICLE NOT IN ('FI')
    AND P.GP_SUPPRIME <> 'X'
    AND P.GP_VENTEACHAT = 'ACH'
    AND L.GL_REFARTBARRE <> ''
    AND L.GL_QTEFACT > 0
    AND L.GL_CODEARTICLE IN ('110112542','110120195','110119569','110109469')

GROUP BY
    P.GP_NATUREPIECEG,
    P.GP_REFINTERNE,
    P.GP_SOUCHE,
    P.GP_NUMERO,
    P.GP_DATEPIECE,
    P.GP_DATELIVRAISON,
    P.GP_TIERS,
    V.T_LIBELLE,
	SIZE.GDI_LIBELLE,
	COLOR.GDI_LIBELLE ,
    L.GL_CODEARTICLE,
    L.GL_REFARTBARRE,

    A.GA_LIBELLE,
    BRAND.CC_LIBELLE

ORDER BY
    P.GP_NATUREPIECEG,
    P.GP_SOUCHE,
    L.GL_CODEARTICLE;
