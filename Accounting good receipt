SELECT 
    a.xblnr_ff,
    CONCAT(a.blf_type, a.blf_site, a.blf_no) AS xblnr_blf,
    a.blf_type,
    a.blf_site,
    a.blf_no,
    a.ga_domaine,
    a.gl_tiers,
    V.T_LIBELLE AS NAMA_VENDOR,
    a.gl_devise,
    CAST(SUM(a.gl_totalht) AS BIGINT) AS AMOUNT
FROM (
    SELECT 
        gl_naturepieceg, 
        gl_souche, 
        gl_numero, 
        gl_tiers,
        gl_devise,
        xblnr_FF = CONCAT(
            RTRIM(gl_naturepieceg), gl_souche, gl_numero
        ), 
        BLF_DATE = SUBSTRING(
            gl_pieceprecedente, 
            1, 
            CHARINDEX(';', gl_pieceprecedente) - 1
        ), 
        BLF_TYPE = SUBSTRING(
            SUBSTRING(
                gl_pieceprecedente, 
                CHARINDEX(';', gl_pieceprecedente) + 1, 
                LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
            ), 
            1, 
            CHARINDEX(
                ';', 
                SUBSTRING(
                    gl_pieceprecedente, 
                    CHARINDEX(';', gl_pieceprecedente) + 1, 
                    LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                )
            ) - 1
        ), 
        BLF_SITE = SUBSTRING(
            SUBSTRING(
                SUBSTRING(
                    gl_pieceprecedente, 
                    CHARINDEX(';', gl_pieceprecedente) + 1, 
                    LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                ), 
                CHARINDEX(
                    ';', 
                    SUBSTRING(
                        gl_pieceprecedente, 
                        CHARINDEX(';', gl_pieceprecedente) + 1, 
                        LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                    )
                ) + 1, 
                LEN(
                    SUBSTRING(
                        gl_pieceprecedente, 
                        CHARINDEX(';', gl_pieceprecedente) + 1, 
                        LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                    )
                ) - CHARINDEX(
                    ';', 
                    SUBSTRING(
                        gl_pieceprecedente, 
                        CHARINDEX(';', gl_pieceprecedente) + 1, 
                        LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                    )
                ) - 1
            ), 
            1, 
            CHARINDEX(
                ';', 
                SUBSTRING(
                    SUBSTRING(
                        gl_pieceprecedente, 
                        CHARINDEX(';', gl_pieceprecedente) + 1, 
                        LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                    ), 
                    CHARINDEX(
                        ';', 
                        SUBSTRING(
                            gl_pieceprecedente, 
                            CHARINDEX(';', gl_pieceprecedente) + 1, 
                            LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                        )
                    ) + 1, 
                    LEN(
                        SUBSTRING(
                            gl_pieceprecedente, 
                            CHARINDEX(';', gl_pieceprecedente) + 1, 
                            LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                        )
                    ) - CHARINDEX(
                        ';', 
                        SUBSTRING(
                            gl_pieceprecedente, 
                            CHARINDEX(';', gl_pieceprecedente) + 1, 
                            LEN(gl_pieceprecedente) - CHARINDEX(';', gl_pieceprecedente) - 1
                        )
                    ) - 1
                )
            ) - 1
        ), 
        /* Perbaikan potongan BLF_NO agar berhenti tepat sebelum titik koma ke-4 */
        BLF_NO = SUBSTRING(
            gl_pieceprecedente, 
            CHARINDEX(';', gl_pieceprecedente, CHARINDEX(';', gl_pieceprecedente, CHARINDEX(';', gl_pieceprecedente) + 1) + 1) + 1, 
            CHARINDEX(';', gl_pieceprecedente + ';', CHARINDEX(';', gl_pieceprecedente, CHARINDEX(';', gl_pieceprecedente, CHARINDEX(';', gl_pieceprecedente) + 1) + 1) + 1) 
            - (CHARINDEX(';', gl_pieceprecedente, CHARINDEX(';', gl_pieceprecedente, CHARINDEX(';', gl_pieceprecedente) + 1) + 1) + 1)
        ), 
        gl_totalht, 
        ga_domaine
    FROM GCLIGNEARTDIM (NOLOCK)
    WHERE gl_pieceprecedente <> '' 
      AND gl_naturepieceg IN ('FF','FFF')
      and gl_datepiece >= '20260101' 
		and gl_datepiece < '20270101'
		AND GL_TYPELIGNE = 'ART'
) AS a
LEFT JOIN TIERS V ON a.gl_tiers = V.T_TIERS
GROUP BY 
    a.xblnr_ff, 
    a.blf_type, 
    a.blf_site, 
    a.blf_no, 
    a.ga_domaine, 
    a.gl_tiers, 
    V.T_LIBELLE, 
    a.gl_devise
ORDER BY a.xblnr_ff;
